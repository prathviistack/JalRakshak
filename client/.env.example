# In local dev, leave these unset — Vite's dev-server proxy (see vite.config.js)
# forwards /api and /socket.io to http://localhost:5000 automatically.
#
# In production (Render, Vercel, Netlify, etc.), set both to your deployed
# backend's URL, since the frontend and backend are served from different origins.
VITE_API_URL=https://your-backend.onrender.com/api
VITE_SOCKET_URL=https://your-backend.onrender.com
